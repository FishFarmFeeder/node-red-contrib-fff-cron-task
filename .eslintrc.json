{
  "env": {
    "es2021": true,
    "node": true,
    "mocha": true
  },
  "extends": "eslint:recommended",
  "parserOptions": {
    "ecmaVersion": 12,
    "sourceType": "script"
  },
  "rules": {
    "no-unused-vars": [
      "error",
      {
        "varsIgnorePattern": "^_",
        "argsIgnorePattern": "^_"
      }
    ],
    "no-console": "off",
    "eqeqeq": ["error", "always"],
    "prefer-const": "error",
    "no-var": "error",
    "curly": ["error", "all"]
  }
}
